{
  "name": "asrparser-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "Capacitor Android shell for asrparser",
  "scripts": {
    "sync-www": "node scripts/sync-www.js",
    "build": "npm run sync-www",
    "test:standalone": "node ../scripts/test-standalone.mjs",
    "test:audio": "node ../scripts/test-app-audio.mjs",
    "test": "npm run test:standalone && npm run test:audio",
    "cap:sync": "npm run sync-www && npx cap sync android",
    "cap:open": "npx cap open android",
    "android": "npm run cap:sync && npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/core": "^6.2.0",
    "@capacitor/splash-screen": "^6.0.2",
    "@capacitor/status-bar": "^6.0.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0"
  }
}
